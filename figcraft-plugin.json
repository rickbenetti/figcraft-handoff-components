{
  "id": "me.benetti.handoff-components",
  "name": "Handoff Components",
  "version": "0.10.0",
  "description": "Generates documentation for the selected component on the same page: numbered anatomy, properties and tokens, spacing and per-variant differences, in one click.",
  "author": "Rick Benetti",
  "main": "handoff_components.wasm",
  "api": 2,
  "permissions": {
    "access": "write",
    "commands": [
      "node.get",
      "variable.list",
      "measure.padding",
      "instance.place",
      "text.create",
      "page.list",
      "frame.create",
      "shape.rectangle",
      "node.set",
      "node.reparent",
      "shape.ellipse",
      "select.set",
      "shape.line",
      "node.find",
      "edit.delete",
      "text.style",
      "component.properties",
      "export.add",
      "style.list",
      "view.get",
      "view.set"
    ]
  },
  "commands": [
    {
      "id": "generate",
      "label": "Generate documentation…"
    }
  ]
}
